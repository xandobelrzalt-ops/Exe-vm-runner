{
  "name": "exe-vm-runner",
  "version": "1.0.0",
  "description": "Node server that accepts an .exe and runs a VM script",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "npx pkg . --targets node18-win-x64 --output dist/Exe-vm-runner.exe"
  },
  "bin": "server.js",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "vm/**/*",
      "uploads/**/*"
    ]
  }
}
